# Copy to .env and fill in. The demo is fully self-contained: nothing here talks
# to a cloud service. The one value you must supply is a Boundary Enterprise
# license (free trial from HashiCorp).

# ---- Boundary Enterprise license (you provide) -----------------------------
# Paste the license string, or point the compose file at a mounted file. This is
# what unlocks session recording and credential injection on self-managed.
BOUNDARY_LICENSE=

# ---- Boundary (local, demo defaults are fine) ------------------------------
# Pin the Enterprise image version. Must be the -ent variant.
BOUNDARY_VERSION=0.20.1-ent
# Controller API address for the HOST CLI (boundary authenticate/connect run on
# your Mac). The PAM app does NOT use this — its address is fixed to the
# in-container name in compose.yml. For CLI use: export BOUNDARY_ADDR=http://localhost:9200
BOUNDARY_ADDR=http://localhost:9200
# Boundary's own Postgres password (its state store).
BOUNDARY_PG_PASSWORD=boundary
# The address clients use to reach the worker's proxy. Clients run on the host, so
# this is localhost:9202 (the worker's published port), not the compose name.
WORKER_PUBLIC_ADDR=localhost:9202
# Written by `make` after terraform apply, so the PAM app can authenticate.
BOUNDARY_AUTH_METHOD_ID=
# The PAM portal's service account (created by terraform).
PAM_OPERATOR_LOGIN=pam-operator
PAM_OPERATOR_PASSWORD=pam-operator-pw
# The demo end-user who drives the flow.
ENGINEER_LOGIN=dana

# ---- Vault (local, demo defaults are fine) ---------------------------------
VAULT_TOKEN=root

# ---- MinIO (local, demo defaults are fine) ---------------------------------
# MinIO server image. Change MINIO_IMAGE if your environment resolves it from a
# different registry. The recording bucket is created with boto3 (no mc client),
# and Boundary accesses the bucket with the root creds below.
MINIO_IMAGE=minio/minio:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=boundary-session-recordings

# ---- Postgres brokering target ---------------------------------------------
POSTGRES_PASSWORD=postgres-demo-pw

# ---- Kubernetes ------------------------------------------------------------
# k3s runs as a compose service reachable at k3s:6443. setup-cluster.sh wires it.

# ---- Grafana ---------------------------------------------------------------
GF_SECURITY_ADMIN_PASSWORD=admin
