{
  "uid": "boundary-audit",
  "title": "Boundary — Who Did What, When",
  "tags": ["boundary", "audit", "pam"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Privileged access events (PAM)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"pam-audit\"} | json | line_format \"{{.request_id}}  {{.actor}}  {{.action}}  {{.detail}}\"" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Access granted vs revoked",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } } },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"pam-audit\"} | json | action=\"access-granted\" [5m]))", "legendFormat": "granted" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"pam-audit\"} | json | action=\"access-revoked\" [5m]))", "legendFormat": "revoked" }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Vault credential brokering (SSH certs, K8s tokens)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"vault-audit\"} | json | request_path=~\"ssh/sign/.*|kubernetes/creds/.*\"" }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Boundary worker — session proxying & recording",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"worker-events\"}" }
      ]
    }
  ]
}
